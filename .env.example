# Pinecone settings.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=medatlas-project
PINECONE_NAMESPACE=llama-text-embed-v2
MAX_BATCH_UPSERT=96
EMBEDDING_DELAY_MS=15000

# Retrieval settings.
EMBEDDING_MODEL=llama-text-embed-v2
TOP_K=5
LOG_LEVEL=info

# Chunk configuration.
MAX_CHUNK_WORDS=950
MARKDOWN_SPLIT_WORDS=850
OVERLAP_WORDS=75
MAX_DISTINCT_SECTIONS=3
