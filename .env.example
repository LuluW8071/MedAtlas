# Express API
PORT=4000
CLIENT_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# Next.js client
NEXT_PUBLIC_API_URL=http://localhost:4000

# Pinecone (embeddings only)
PINECONE_API_KEY=
EMBEDDING_MODEL=llama-text-embed-v2
MAX_BATCH_UPSERT=96
EMBEDDING_DELAY_MS=15000
TOP_K=5
LOG_LEVEL=info

# Local MongoDB: conversations, checkpoints, answer cache, keyword index
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=medatlas

# Cohere reranker (hybrid retrieval degrades to fused order without it)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
HISTORY_TOKEN_BUDGET=3000

# Local Qdrant: dense + BM25 hybrid index
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=medatlas
EMBEDDING_DIMENSIONS=1024

# Local llama-server embeddings (llama-server -hf luluw/Qwen3-MedEmbed-0.6B-Miriad-32k-en-trim-gguf:Q4_K_M -c 4096 --batch-size 768 --ubatch-size 768 -t 4 -ngl 999 --host 0.0.0.0 --port 8080 --embedding --pooling last --parallel 8 --flash-attn on)
EMBEDDING_URL=http://127.0.0.1:8080
EMBEDDING_MODEL=Qwen3-MedEmbed-0.6B
